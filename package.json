{
  "name": "group-ride",
  "version": "1.12.2",
  "description": "Discord bot to organise group cycling rides",
  "workspaces": [
    "website"
  ],
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix src tests",
    "typecheck": "bunx tsc --noEmit",
    "website": "bun run --cwd website dev",
    "release": "git tag -a \"v$(node -p \"require('./package.json').version\")\" -m \"Release v$(node -p \"require('./package.json').version\")\" && git push --tags"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "discord.js": "^14.28.1",
    "gpxsnap": "^1.3.0",
    "grammy": "^1.46.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^25.9.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "pino-pretty": "^13.2.0"
  },
  "overrides": {
    "undici": "^6.29.1",
    "ws": "^8.21.1"
  }
}
